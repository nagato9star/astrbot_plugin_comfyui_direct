{
  "_conn_section": {
    "description": "=== 连接 ===",
    "type": "text",
    "invisible": true
  },
  "comfyui_host": {
    "type": "string",
    "default": "127.0.0.1",
    "hint": "ComfyUI 主机 IP（默认本机 127.0.0.1；局域网/ZeroTier 填对应地址）",
    "description": "ComfyUI 服务地址 IP，可按实际环境自填"
  },
  "comfyui_port": {
    "type": "int",
    "default": 8188,
    "hint": "ComfyUI 服务端口，默认 8188"
  },
  "comfyui_timeout": {
    "type": "int",
    "default": 300,
    "slider": {
      "min": 60,
      "max": 1800,
      "step": 30
    },
    "hint": "单次生成等待上限（秒）。大分辨率/多 LoRA 建议不低于 300；链路经 ZeroTier 等中转时适当调大。超时后任务仍在 ComfyUI 队列里，可用 comfyui_job 查询。"
  },
  "model_cache_ttl": {
    "type": "int",
    "default": 600,
    "slider": {
      "min": 0,
      "max": 3600,
      "step": 60
    },
    "hint": "模型/LoRA 清单缓存刷新间隔（秒）。0 表示每次查询都强制同步（ComfyUI 端会多一次请求）；装了 LoRA Manager 时分类标签随缓存一并刷新。"
  },
  "lora_manager_enabled": {
    "type": "bool",
    "default": true,
    "hint": "复用 ComfyUI LoRA Manager 的分类、标签、用途说明、推荐权重和触发词；未安装时自动跳过"
  },
  "_family_section": {
    "description": "=== 模型家族与配方 ===",
    "type": "text",
    "invisible": true
  },
  "model_families": {
    "type": "template_list",
    "description": "模型家族与工作流",
    "hint": "可添加任意家族，家族名是暴露给 LLM 的稳定路由名。先在配方工作台导入工作流，再在这里为每个家族选择工作流；修改后重载插件生效。",
    "obvious_hint": true,
    "templates": {
      "family": {
        "name": "模型家族",
        "items": {
          "name": {
            "type": "string",
            "default": "anima",
            "hint": "暴露给 LLM 的稳定名称，例如 anima、krea2、flux；须唯一，重复时保留第一条"
          },
          "workflow": {
            "type": "string",
            "default": "anima-v3",
            "hint": "这个家族使用的工作流：填配方工作台里导入的模板名。多个家族可以共用同一张工作流"
          },
          "prompt_style": {
            "type": "string",
            "default": "auto",
            "options": [
              "auto",
              "danbooru",
              "natural"
            ],
            "labels": [
              "自动判断",
              "Danbooru 标签串",
              "自然语言"
            ],
            "hint": "提示 LLM 用哪种提示词风格：anima/illustrious 系选标签串，krea/flux/qwen 系选自然语言，不确定选自动判断"
          },
          "description": {
            "type": "string",
            "default": "",
            "hint": "简短说明适合的画面或用途，会随家族名一起暴露给 LLM，帮它选对家族"
          }
        }
      }
    },
    "default": [
      {
        "__template_key": "family",
        "name": "anima",
        "workflow": "anima-v3",
        "prompt_style": "danbooru",
        "description": "动漫标签提示词"
      }
    ]
  },
  "workflow_node_mappings": {
    "type": "template_list",
    "description": "工作流节点映射（配置优先）",
    "hint": "按工作流手动指定机器人可以修改的节点。节点填写纯 ID（如 478）或“ID — 节点类型 — 标题”。只要添加了该工作流条目，留空槽位就保持未映射；配置优先于 Workflow Studio 档案和自动检测，修改后重载插件生效。",
    "obvious_hint": true,
    "templates": {
      "mapping": {
        "name": "工作流节点映射",
        "items": {
          "workflow": {
            "type": "string",
            "default": "",
            "hint": "工作流模板名，须与模型家族中的 workflow 完全一致"
          },
          "prompt": {
            "type": "string",
            "default": "",
            "hint": "主提示词节点 ID（必填）"
          },
          "model": {
            "type": "string",
            "default": "",
            "hint": "底模加载节点 ID（允许机器人换底模时填写）"
          },
          "loras": {
            "type": "string",
            "default": "",
            "hint": "可选 LoRA 节点 ID；Anima 应映射 Power Loader，不要映射独立加速节点"
          },
          "size": {
            "type": "string",
            "default": "",
            "hint": "画面宽高节点 ID"
          },
          "sampler": {
            "type": "string",
            "default": "",
            "hint": "主采样节点 ID（必填）"
          },
          "sampler_2": {
            "type": "string",
            "default": "",
            "hint": "双采样第二段节点 ID；留空时保持第二段独立参数"
          },
          "negative": {
            "type": "string",
            "default": "",
            "hint": "负向提示词节点 ID"
          },
          "artist": {
            "type": "string",
            "default": "",
            "hint": "画师风格节点 ID"
          },
          "quality": {
            "type": "string",
            "default": "",
            "hint": "画质词节点 ID"
          },
          "trigger_words": {
            "type": "string",
            "default": "",
            "hint": "LoRA 触发词节点 ID"
          },
          "clip": {
            "type": "string",
            "default": "",
            "hint": "CLIP 加载节点 ID"
          },
          "vae": {
            "type": "string",
            "default": "",
            "hint": "VAE 加载节点 ID"
          },
          "guidance": {
            "type": "string",
            "default": "",
            "hint": "FluxGuidance 等引导强度节点 ID"
          }
        }
      }
    },
    "default": []
  },
  "default_recipe": {
    "type": "string",
    "default": "默认",
    "hint": "用户只说「画一张」时 comfyui_recipe_draw / comfyui_generate 用的配方名；在配方工作台点「设为默认」自动写入，也可直接填配方名"
  },
  "_tool_section": {
    "description": "=== LLM 工具 ===",
    "type": "text",
    "invisible": true
  },
  "llm_tool_mode": {
    "type": "string",
    "default": "basic",
    "options": [
      "basic",
      "full"
    ],
    "labels": [
      "基础（画图 + 查词）",
      "完整（开放诊断工具）"
    ],
    "hint": "basic 只暴露 comfyui_draw / comfyui_recipe_draw / comfyui_lookup；full 额外开放队列、任务、模型信息等诊断工具，其中高风险工具仍需打开下方开关"
  },
  "allow_llm_unsafe_tools": {
    "type": "bool",
    "default": false,
    "hint": "允许 LLM 执行任意工作流 JSON、上传本地文件到 ComfyUI、释放显存和删除配方。存在误操作与数据丢失风险，默认关闭；确有需要再开"
  },
  "node_slots": {
    "type": "object",
    "invisible": true,
    "description": "告诉插件：工作流里哪个格子写用户的话、哪个出图、哪个换底模。选好后机器人就不会填错。导入工作流后选项会刷新，重载插件生效。不会用的格子留空即可。",
    "items": {
      "prompt": {
        "type": "string",
        "default": "",
        "hint": "用户要画的内容写到哪（必选）"
      },
      "model": {
        "type": "string",
        "default": "",
        "hint": "底模写到哪（想让机器人换模型就选）"
      },
      "loras": {
        "type": "string",
        "default": "",
        "hint": "LoRA 写到哪"
      },
      "size": {
        "type": "string",
        "default": "",
        "hint": "画面宽高写到哪"
      },
      "sampler": {
        "type": "string",
        "default": "",
        "hint": "出图采样写到哪（步数/精细程度，必选）。双采样时选第一段"
      },
      "sampler_2": {
        "type": "string",
        "default": "",
        "hint": "双采样第二段写到哪（可留空；映射后才同步步数和种子，共享外联节点会自然联动）"
      },
      "negative": {
        "type": "string",
        "default": "",
        "hint": "不要出现的东西写到哪（可留空）"
      },
      "artist": {
        "type": "string",
        "default": "",
        "hint": "画师风格写到哪（可留空）"
      },
      "quality": {
        "type": "string",
        "default": "",
        "hint": "画质词写到哪（可留空）"
      },
      "trigger_words": {
        "type": "string",
        "default": "",
        "hint": "LoRA 触发词写到哪（可留空）"
      },
      "clip": {
        "type": "string",
        "default": "",
        "hint": "换文本编码器（Flux/Krea/Qwen 等独立 CLIP 的模型才需要，可留空）"
      },
      "vae": {
        "type": "string",
        "default": "",
        "hint": "换 VAE（模型用独立 VAE 时才需要，可留空）"
      },
      "guidance": {
        "type": "string",
        "default": "",
        "hint": "FluxGuidance 之类的引导值节点（可留空）"
      }
    }
  },
  "_lookup_section": {
    "description": "=== 查询源 ===",
    "type": "text",
    "invisible": true
  },
  "danbooru_base_url": {
    "type": "string",
    "default": "https://danbooru.donmai.us",
    "obvious_hint": true,
    "description": "danbooru API 文档：https://danbooru.donmai.us/wiki_pages/help:api",
    "hint": "danbooru 接口地址，国内可换可用镜像；官方 API 文档 https://danbooru.donmai.us/wiki_pages/help:api（可点击链接见 Workflow Studio 侧栏「相关链接」）"
  },
  "gelbooru_base_url": {
    "type": "string",
    "default": "https://gelbooru.com",
    "obvious_hint": true,
    "description": "gelbooru DAPI 文档：https://gelbooru.com/index.php?page=help&topic=dapi",
    "hint": "gelbooru 接口地址（镜像可换）；DAPI 文档 https://gelbooru.com/index.php?page=help&topic=dapi（可点击链接见 Workflow Studio 侧栏）"
  },
  "civitai_api_key": {
    "type": "string",
    "default": "",
    "obvious_hint": true,
    "description": "API Key 获取：https://civitai.com/user/account（镜像站路径相同）",
    "hint": "civitai API Key（可选，以你的身份调用）：获取 https://civitai.com/user/account，镜像站路径相同；API 参考 https://github.com/civitai/civitai/wiki/REST-API-Reference（可点击链接见 Workflow Studio 侧栏）"
  },
  "_legacy_defaults_section": {
    "description": "=== 旧版兼容默认值（有配方后以配方为准） ===",
    "type": "text",
    "invisible": true
  },
  "default_artist": {
    "type": "string",
    "invisible": true,
    "default": "",
    "hint": "默认画师串（如 (@名字:1.2)），留空用模板原值；仅 comfyui_generate 未传 artist 时生效"
  },
  "default_quality": {
    "type": "string",
    "invisible": true,
    "default": "",
    "hint": "默认质量词（如 masterpiece, best quality, score_9），留空用模板原值"
  },
  "default_trigger_words": {
    "type": "string",
    "invisible": true,
    "default": "",
    "hint": "默认 lora 触发词（如 @f1f,@deadpuritystyle），留空用模板原值"
  },
  "default_negative_prompt": {
    "type": "string",
    "invisible": true,
    "default": "",
    "hint": "默认负向提示词，留空用模板原值"
  },
  "default_model": {
    "type": "string",
    "invisible": true,
    "default": "",
    "hint": "没有配方时的兜底底模。有配方后以配方为准"
  },
  "default_lora": {
    "type": "template_list",
    "invisible": true,
    "description": "默认 LoRA 列表：可添加多条，按顺序映射 Power Lora Loader 插槽 lora_1..lora_N；每条含文件名与权重",
    "templates": {
      "lora": {
        "name": "LoRA",
        "items": {
          "name": {
            "type": "string",
            "default": "",
            "hint": "LoRA 文件名，需与 ComfyUI models/loras 下的相对路径一致"
          },
          "strength": {
            "type": "float",
            "default": 0.8,
            "slider": {
              "min": 0,
              "max": 1.5,
              "step": 0.05
            },
            "hint": "权重，常用 0.5~1.0"
          }
        }
      }
    },
    "default": []
  },
  "default_steps": {
    "type": "int",
    "invisible": true,
    "default": 0,
    "slider": {
      "min": 0,
      "max": 100,
      "step": 1
    },
    "hint": "默认采样步数，0=用模板原值"
  },
  "default_cfg": {
    "type": "float",
    "invisible": true,
    "default": 0,
    "slider": {
      "min": 0,
      "max": 20,
      "step": 0.5
    },
    "hint": "默认 CFG，0=用模板原值"
  },
  "default_sampler_name": {
    "type": "string",
    "invisible": true,
    "default": "",
    "options": [
      "",
      "er_sde",
      "euler",
      "euler_ancestral",
      "dpmpp_2m",
      "dpmpp_2m_sde",
      "dpmpp_3m_sde",
      "dpmpp_sde",
      "ddim",
      "uni_pc",
      "lcm"
    ],
    "hint": "默认采样器，留空=用模板原值"
  },
  "default_scheduler": {
    "type": "string",
    "invisible": true,
    "default": "",
    "options": [
      "",
      "normal",
      "karras",
      "exponential",
      "sgm_uniform",
      "simple",
      "beta"
    ],
    "hint": "默认调度器，留空=用模板原值"
  },
  "default_denoise": {
    "type": "float",
    "invisible": true,
    "default": 0,
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    "hint": "默认降噪强度 0~1，0=用模板原值"
  },
  "default_width": {
    "type": "int",
    "invisible": true,
    "default": 0,
    "hint": "默认图片宽度，0=用模板原值"
  },
  "default_height": {
    "type": "int",
    "invisible": true,
    "default": 0,
    "hint": "默认图片高度，0=用模板原值"
  },
  "default_workflow": {
    "type": "string",
    "default": "anima-v3",
    "hint": "旧版兼容项；model_families 为空时作为兜底工作流",
    "invisible": true
  },
  "_animadex_section": {
    "description": "=== AnimaDex 角色库 ===",
    "type": "text",
    "invisible": true
  },
  "animadex_mcp_url": {
    "description": "AnimaDex MCP 服务地址",
    "type": "string",
    "default": "http://127.0.0.1:11451/mcp",
    "hint": "本地角色库 MCP 服务端点；不使用 AnimaDex 查询可忽略"
  },
  "animadex_timeout": {
    "description": "AnimaDex 查询超时（秒）",
    "type": "float",
    "default": 8.0,
    "slider": {
      "min": 1,
      "max": 60,
      "step": 1
    },
    "hint": "单次角色库查询的等待上限，超时自动放弃并回退其他查询源"
  }
}
