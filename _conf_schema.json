    "type": "string",
    "default": "127.0.0.1",
    "hint": "ComfyUI 主机 IP（默认本机）",
    "description": "ComfyUI 服务地址 IP，可按实际环境自填"
  },
  "comfyui_port": {
    "type": "int",
    "default": 8188,
    "hint": "ComfyUI 端口"
  },
