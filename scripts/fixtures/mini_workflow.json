  "9": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["10", 0] }
  },
  "10": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "vae.safetensors" }
  }
